{
  "name": "@kristian/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/analytics/web', 'dist/analytics/web', { recursive: true });\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/app.test.ts src/analytics/*.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@kristian/contracts": "workspace:*",
    "express": "5.2.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^20",
    "@types/pg": "^8",
    "typescript": "7.0.2",
    "tsx": "4.23.12"
  }
}
