{
  "name": "@kristian/portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build && node scripts/package-web.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @kristian/contracts build && pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
