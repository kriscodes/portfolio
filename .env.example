# API only. Public portfolio pages are statically generated.
PORT=3211
# In-house analytics. Never commit real secrets or an owner password.
# The database, setup token, and hash secret are required for production.
DATABASE_URL=postgresql://postgres:local-development-only@localhost:5432/portfolio
ANALYTICS_OWNER_EMAIL=owner@example.com
ANALYTICS_ORIGIN=http://localhost:3211
# Generate independent random values of at least 32 characters.
ANALYTICS_SETUP_TOKEN=
ANALYTICS_HASH_SECRET=
# Public build-time setting for the portfolio collector. Local development only:
NEXT_PUBLIC_ANALYTICS_ORIGIN=http://localhost:3211
